---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mascot from '../components/Mascot.astro';

interface Props {
  title: string;
  description?: string;
  page?: string;
  ogType?: 'website' | 'article';
  indexable?: boolean; // false: hide from search engines and the site search
  greet?: string;
  tips?: string[];
}
const {
  title,
  description = 'Anup Narayanam: web developer, UI designer and security researcher. Portfolio, CTF writeups and a security blog.',
  page = '',
  ogType = 'website',
  indexable = true,
  greet = '',
  tips = [],
} = Astro.props;
const fullTitle = title === 'Anup Narayanam' ? title : `${title} | Anup Narayanam`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/assets/profile.jpg', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3f3f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Anup Narayanam, blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body data-page={page} data-greet={greet} data-tips={JSON.stringify(tips)}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="grid"></div>
    <Header page={page} />
    <main id="main" tabindex="-1" data-pagefind-body={indexable ? '' : undefined}><slot /></main>
    <Footer />
    <Mascot />
    <script>
      import '../scripts/shell.js';
    </script>
    <script>
      import { injectSpeedInsights } from '@vercel/speed-insights';
      injectSpeedInsights();
    </script>
  </body>
</html>
