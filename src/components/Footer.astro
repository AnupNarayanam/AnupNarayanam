---
import { SITE } from '../data/profile.ts';
import { ICONS } from '../data/icons.ts';
const links = [['Projects', '/projects/'], ['Writeups', '/writeups/'], ['Blog', '/blog/'], ['About', '/about/'], ['Contact', '/contact/'], ['Search', '/search/'], ['RSS', '/rss.xml']];
const social = [['GitHub', SITE.github, ICONS.github], ['LinkedIn', SITE.linkedin, ICONS.linkedin], ['Instagram', SITE.instagram, ICONS.instagram]];
---
<footer class="site-f">
  <div class="wrap ft">
    <div>
      <a class="logo" href="/">ANUP<i>{' / '}</i>NARAYANAM</a>
      <p class="mute">Web developer, UI designer and security researcher.</p>
    </div>
    <ul class="ft-links">
      {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <div class="soc">
      {social.map(([label, href, icon]) => <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}><Fragment set:html={icon} /></a>)}
    </div>
  </div>
  <div class="wrap ft-b">
    <span>&copy; {new Date().getFullYear()} {SITE.name}. Built with Astro.</span>
    <button class="up" id="up" type="button">Back to top</button>
  </div>
</footer>
