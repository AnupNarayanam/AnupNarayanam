---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/profile.ts';
---
<Base title="Contact" page="contact" description="Get in touch with Anup Narayanam: email, phone, location and a contact form." greet="Say hi. He replies within a day." tips={['The copy button grabs the email.']}>
  <div class="wrap pgh"><span class="ix">@</span><h1>Get in touch</h1><p>Open to projects, collaborations and CTF teams. I reply within 24 hours.</p></div>
  <section class="wrap sec">
    <div class="contact">
      <div class="box" data-reveal>
        <h3>Contact information</h3>
        <ul class="info mt">
          <li><small>Email</small><a href={`mailto:${SITE.email}`}>{SITE.email}</a><button class="copy" id="copy" type="button">Copy</button></li>
          <li><small>Phone</small><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></li>
          <li><small>Location</small>{SITE.location}</li>
          <li><small>Working hours</small>Monday to Friday, 9am to 5pm IST. Response time: within 24 hours.</li>
          <li><small>Elsewhere</small><span class="pills">
            <a class="pill" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="pill" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a class="pill" href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          </span></li>
        </ul>
      </div>
      <div class="box" data-reveal>
        <h3>Send me a message</h3>
        <form id="form" class="form mt" action={`mailto:${SITE.email}`} method="post" enctype="text/plain">
          <div class="fld"><label for="name">Your name</label><input id="name" name="name" type="text" required autocomplete="name" /></div>
          <div class="fld"><label for="email">Email address</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
          <div class="fld"><label for="subject">Subject</label><input id="subject" name="subject" type="text" /></div>
          <div class="fld"><label for="message">Your message</label><textarea id="message" name="message" rows="5" required></textarea></div>
          <div class="hp" aria-hidden="true"><label>Leave this empty<input name="_gotcha" type="text" tabindex="-1" autocomplete="off" /></label></div>
          <div><button class="btn solid" type="submit">Send message</button></div>
          <p id="fstat" class="fstat" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
  <script>
    import '../scripts/contact.js';
  </script>
</Base>
